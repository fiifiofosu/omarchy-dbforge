# Post-transaction messages and service wiring.
#
# dbforged is a *user* service: it runs as you, talks to your rootless Podman
# socket, and owns containers in your user namespace. pacman runs as root and
# has no user session, so it cannot start it. What it can do is `systemctl
# --global enable`, which links the unit into every user's default.target --
# the standard Arch mechanism for a user service shipped by a package.

_note() { printf '\033[1m==>\033[0m %s\n' "$1"; }

# Overridable only so the branch can be tested without writing to /etc. pacman
# sources this file inside its own transaction, so this is not a usable opt-out
# at install time -- the marker file is.
: "${_DBFORGE_MARKER:=/etc/dbforge/no-autoenable}"

_enable() {
  # Opt-out: create this file before installing (or before an upgrade that
  # would re-enable it) to keep the service off for everyone.
  if [ -e "$_DBFORGE_MARKER" ]; then
    _note "$_DBFORGE_MARKER exists; leaving dbforged disabled."
    return
  fi
  systemctl --global enable dbforged.service >/dev/null 2>&1 || true
  _note "Enabled dbforged for all users on next login."
  _note "  Opt out:  sudo mkdir -p /etc/dbforge && sudo touch /etc/dbforge/no-autoenable"
  _note "            sudo systemctl --global disable dbforged.service"
}

post_install() {
  _enable
  cat <<'EOF'

  Two things DBForge cannot do for you:

    systemctl --user enable --now podman.socket
        The daemon talks to your rootless Podman socket.

    sudo loginctl enable-linger $USER
        Without lingering, your databases stop when you log out and do not
        come back until you log back in.

  Then:
    systemctl --user start dbforged
    dbctl create postgres:16 --name app-db

  Waybar widget (optional):
    /usr/share/dbforge/waybar/install.sh

  Your data lives in ~/.local/share/dbforge and is never touched by pacman.

EOF
}

post_upgrade() {
  _enable
  cat <<'EOF'

  The new binaries are installed, but the running daemon is still the old one.
  Pick it up with:

    systemctl --user restart dbforged

  This does not stop your databases. The daemon reattaches to the containers
  that are already running; restarting it is not restarting them.

EOF
}

pre_remove() {
  systemctl --global disable dbforged.service >/dev/null 2>&1 || true
}

post_remove() {
  cat <<'EOF'

  DBForge is removed. Your databases are NOT:

    containers:  podman ps -a --filter label=io.dbforge.managed
    data:        ~/.local/share/dbforge
    config:      ~/.config/dbforge/instances.toml

  That is deliberate -- uninstalling a manager should never delete the data it
  was managing. To remove them too, reinstall dbforge and run
  `dbctl rm <id> --wipe-data` for each instance, or remove the containers with
  podman and delete the directory yourself.

  You may also want:
    systemctl --user disable --now dbforged
    rm -f ~/.config/systemd/user/dbforged.service   # only if you ever ran the
                                                    # per-user install script

EOF
}
