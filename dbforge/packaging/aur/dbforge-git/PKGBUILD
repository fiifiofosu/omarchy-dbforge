# Maintainer: Ebenezer N. Ofosu <ebenezern.ofosu@gmail.com>
pkgname=dbforge-git
_pkgname=dbforge
pkgver=0.0.0
pkgrel=1
pkgdesc="Local database instance manager for Omarchy, backed by rootless Podman"
arch=('x86_64' 'aarch64')
url="https://github.com/fiifiofosu/dbforge"
license=('MIT')
# podman is a hard runtime dependency: dbforge has no other backend, and the
# daemon exits with a clear error rather than half-working without it.
depends=('podman')
makedepends=('go' 'git')
# waybar is optional because the CLI and TUI are complete without a bar, and
# the widget installer is opt-in either way.
optdepends=('waybar: status widget and quick start/stop menu')
provides=("$_pkgname")
conflicts=("$_pkgname")
install="$_pkgname.install"
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname"
  local desc
  # v1.2.3-4-gabcdef -> 1.2.3.r4.gabcdef. Note the `if` rather than a pipeline
  # with `||`: the pipeline's status is sed's, so an untagged repo would
  # produce an empty pkgver instead of taking the fallback.
  if desc=$(git describe --long --tags 2>/dev/null) && [ -n "$desc" ]; then
    printf '%s' "$desc" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    # No tags yet: commit count keeps it monotonic so upgrades still apply.
    printf '0.0.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

prepare() {
  cd "$srcdir/$_pkgname"
  # Modules are fetched here so build() can run with networking disabled, which
  # is how a clean chroot build works.
  go mod download
}

build() {
  cd "$srcdir/$_pkgname"
  # Arch's Go packaging flags: PIE, full RELRO, and no VCS stamping (makepkg
  # builds from a detached checkout, which Go would otherwise mark dirty).
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw -buildvcs=false"
  make VERSION="$pkgver" PREFIX=/usr build
}

check() {
  cd "$srcdir/$_pkgname"
  # Unit tests only. The integration suite needs a live rootless Podman socket,
  # which a build chroot does not have.
  go test ./...
}

package() {
  cd "$srcdir/$_pkgname"
  make DESTDIR="$pkgdir" PREFIX=/usr VERSION="$pkgver" install
}
